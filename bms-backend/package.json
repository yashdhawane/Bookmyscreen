{
  "name": "bookmyscreen",
  "version": "1.0.0",
  "description": "Movie Booking System",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed:movies": "node dist/scripts/seed-movies.js",
    "seed:shows": "node dist/scripts/seed-shows.js",
    "seed:theaters": "node dist/scripts/seed-theaters.js",
    "seed": "npm run seed:movies && npm run seed:theaters && npm run seed:shows",
    "start:prod": "npm run seed && npm start"

    
  },
